pragma Singleton
import QtQuick
import QtWebSockets

QtObject {
    id: root

    property string url: "ws://127.0.0.1:8765"

    property bool connected: (ws.status === WebSocket.Open)
    property string statusText: connected ? (lastStatus.length ? lastStatus : "connected") : "disconnected"

    property real rpm: 0
    property real speedKph: 0
    property real coolantC: 0
    property real throttlePct: 0

    property bool warnCoolantHigh: false
    property bool warnOverspeed: false

    property double lastTs: 0

    // perf (performance / performance): limit UI churn
    property int uiUpdateMinMs: 50
    property double _lastUiUpdateMs: 0

    property string lastStatus: ""
    property int reconnectMs: 1000

    Timer {
        id: reconnectTimer
        interval: root.reconnectMs
        repeat: false
        onTriggered: ws.active = true
    }

    WebSocket {
        id: ws
        url: root.url
        active: true

        onStatusChanged: {
            root.lastStatus = (status === WebSocket.Open) ? "open"
                           : (status === WebSocket.Connecting) ? "connecting"
                           : (status === WebSocket.Closing) ? "closing"
                           : "closed"
            if (status === WebSocket.Closed) reconnectTimer.restart()
        }

        onErrorStringChanged: {
            if (errorString && errorString.length)
                root.lastStatus = "error: " + errorString
        }

        onTextMessageReceived: (message) => {
            let obj
            try { obj = JSON.parse(message) } catch (e) { return }

            const nowMs = Date.now()
            if (nowMs - root._lastUiUpdateMs < root.uiUpdateMinMs) return
            root._lastUiUpdateMs = nowMs

            if (obj.ts !== undefined) root.lastTs = obj.ts
            if (obj.rpm !== undefined) root.rpm = obj.rpm
            if (obj.speed_kph !== undefined) root.speedKph = obj.speed_kph
            if (obj.coolant_c !== undefined) root.coolantC = obj.coolant_c
            if (obj.throttle_pct !== undefined) root.throttlePct = obj.throttle_pct

            if (obj.warnings) {
                root.warnCoolantHigh = !!obj.warnings.coolant_high
                root.warnOverspeed   = !!obj.warnings.overspeed
            }

            if (obj.status) root.lastStatus = obj.status
        }
    }
}